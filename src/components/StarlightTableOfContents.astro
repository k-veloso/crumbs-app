---
import DefaultTableOfContents from "@astrojs/starlight/components/TableOfContents.astro";

const { toc } = Astro.locals.starlightRoute;
const serializedOutline = JSON.stringify(toc?.items ?? []).replace(
  /</g,
  "\\u003c",
);
---

<aside class="crumbs-demo-help-prompt" role="note">
  <strong>Tip: try a different way to navigate</strong>
  <span>
    Want to give Crumbs a try? Explore this guide with the demo outline.
  </span>
  <button type="button" data-crumbs-demo-activate>Try the outline</button>
</aside>

<aside class="crumbs-toc-notice" role="note" aria-label="Crumbs outline status">
  <strong>The Crumbs extension is hidden on this site</strong>
  <span>
    Open the Crumbs extension from the browser toolbar and choose <kbd>Show</kbd
    >
    to use its outline.
  </span>
</aside>

<DefaultTableOfContents />
<script
  id="crumbs-demo-outline-data"
  type="application/json"
  is:inline
  set:html={serializedOutline}
/>
