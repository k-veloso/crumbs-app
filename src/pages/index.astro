---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import markdownRaw from "../assets/images/mockups/markdown-raw.png";
import markdownReader from "../assets/images/mockups/markdown-reader.png";
import quietOutline from "../assets/images/mockups/quiet-outline.png";
import searchHeadings from "../assets/images/mockups/search-headings.png";
import { withBase } from "../lib/paths";
---

<SiteLayout
  title="Crumbs"
  description="A Chrome extension for navigating long pages and reading standalone Markdown without losing your place."
  bodyClass="landing-page"
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-dot"></span>Navigate any page</p>
      <h1>Keep your place.<br /><span>Find what matters.</span></h1>
      <p class="hero-lede">
        Crumbs turns a page's headings into a focused outline and gives
        standalone Markdown a clean, readable view—without sending your reading
        to a developer server.
      </p>
      <div class="hero-actions">
        <a
          class="button button-primary"
          href={withBase("/help/getting-started/")}>See how Crumbs works</a
        >
        <a class="button button-secondary" href={withBase("/help/")}
          >Browse help <span aria-hidden="true">→</span></a
        >
      </div>
      <p class="availability-note">
        An install link will appear here when a verified store listing is
        available.
      </p>
    </div>

    <figure class="product-preview mockup-window mockup-window-hero">
      <div class="mockup-toolbar" aria-hidden="true">
        <span></span><span></span><span></span>
        <p>A long page, made navigable</p>
      </div>
      <Image
        src={quietOutline}
        alt="Crumbs expanded beside a long article, showing its nested heading outline and active section"
        width={1383}
        layout="constrained"
        format="webp"
        quality={90}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <figcaption>
        <span><i></i>Real extension interface</span>
        <span>Glazed · Caramel</span>
      </figcaption>
    </figure>
  </section>

  <section class="trust-strip" aria-label="Crumbs product highlights">
    <div class="shell trust-items">
      <span>Collapsible outlines</span>
      <span>Search and depth filters</span>
      <span>Online and local Markdown</span>
      <span>Glazed or Plain</span>
    </div>
  </section>

  <section class="section shell" id="features">
    <div class="section-intro">
      <p class="eyebrow">
        <span class="small-dot"></span>Made for your reading flow
      </p>
      <h2>Less hunting.<br />More understanding.</h2>
      <p>
        Move through dense pages with a compact set of tools that stay out of
        the way until you need them.
      </p>
    </div>
    <nav class="feature-index" aria-label="Feature details">
      <a href="#page-outline"><span>01</span>Page outline</a>
      <a href="#markdown-reader"><span>02</span>Markdown reader</a>
      <a href="#appearance"><span>03</span>Appearance</a>
    </nav>
  </section>

  <section class="feature-detail shell" id="page-outline">
    <div class="feature-detail-copy">
      <p class="feature-kicker"><span>01</span>Navigate long pages</p>
      <h2>A living outline that knows when to get out of the way.</h2>
      <p class="feature-lede">
        Crumbs turns meaningful headings into a compact hierarchy, follows your
        current section, and folds back into a narrow rail whenever it is not
        hovered or pinned.
      </p>
      <ul class="feature-points">
        <li>
          <strong>Move with the document.</strong>
          Click a heading to scroll smoothly to it and briefly highlight the destination
          on the page.
        </li>
        <li>
          <strong>Preview without losing your flow.</strong>
          Hold <kbd>Shift</kbd> and hover over headings to move between sections
          quickly, without changing the URL or adding a page highlight.
        </li>
        <li>
          <strong>Collapse nested groups.</strong>
          Fold finished branches away, then reveal them again when you need their
          detail.
        </li>
        <li>
          <strong>Copy a link to the exact section.</strong>
          Crumbs reuses a stable page anchor when one exists and can create a text-fragment
          link like Chrome's Copy link to highlight.
        </li>
        <li>
          <strong>Search, then choose a depth.</strong>
          Filter headings by text or show only levels through H1, H2, H3, and beyond.
          Hover a truncated heading to see its complete text in a tooltip.
        </li>
      </ul>
    </div>
    <figure class="feature-visual mockup-window">
      <div class="mockup-toolbar" aria-hidden="true">
        <span></span><span></span><span></span><p>Find a heading</p>
      </div>
      <Image
        src={searchHeadings}
        alt="Crumbs filtering a page outline to headings matching the word read"
        width={1383}
        layout="constrained"
        format="webp"
        quality={90}
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <span><i></i>Search in place</span><span>Only matching headings</span>
      </figcaption>
    </figure>
  </section>

  <section class="feature-band" id="markdown-reader">
    <div class="feature-detail feature-detail-reader shell">
      <div class="feature-detail-copy">
        <p class="feature-kicker"><span>02</span>Read Markdown</p>
        <h2>Readable when you want it. Raw when you need it.</h2>
        <p class="feature-lede">
          Open standalone Markdown from the web or from local files, then move
          between a calm rendered document and its original source.
        </p>
        <ul class="feature-points">
          <li>
            <strong>Built for real documents.</strong>
            Read common Markdown plus GitHub-Flavored Markdown features such as tables,
            task lists, strikethrough, autolinks, and alerts.
          </li>
          <li>
            <strong>Diagrams stay useful.</strong>
            Mermaid diagrams include zoom, pan, reset, and source-copy controls.
          </li>
          <li>
            <strong>Code remains practical.</strong>
            Syntax-highlighted code blocks include quick copy and per-block line
            wrapping.
          </li>
          <li>
            <strong>Local files are supported.</strong>
            Enable local Markdown in Crumbs and grant Chrome file access once; the
            document itself remains on your device.
          </li>
        </ul>
        <a class="feature-link" href={withBase("/help/markdown-reader/")}
          >Explore Markdown support <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="reader-compare" aria-label="Rendered and Raw Markdown views">
        <figure class="reader-shot">
          <div class="shot-label">
            <span>Rendered</span><small>Readable view</small>
          </div>
          <Image
            src={markdownReader}
            alt="A public Markdown document rendered in dark mode with the Crumbs outline open"
            width={1380}
            layout="constrained"
            format="webp"
            quality={90}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="reader-shot reader-shot-raw">
          <div class="shot-label">
            <span>Raw</span><small>Original source</small>
          </div>
          <Image
            src={markdownRaw}
            alt="The same public Markdown document in Raw view with the Crumbs outline open"
            width={1378}
            layout="constrained"
            format="webp"
            quality={90}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section
    class="feature-detail feature-detail-appearance shell"
    id="appearance"
  >
    <div class="feature-detail-copy">
      <p class="feature-kicker"><span>03</span>Make it yours</p>
      <h2>Blend into the page—or hold a clear edge.</h2>
      <p class="feature-lede">
        The interaction stays consistent while the surface adapts to the kind of
        page you are reading.
      </p>
      <ul class="feature-points">
        <li>
          <strong>Glazed adapts.</strong>
          Its translucent, glass-like surface samples the page behind it and adjusts
          its tint and light or dark treatment automatically.
        </li>
        <li>
          <strong>Plain stays solid.</strong>
          Choose a solid Light, Dark, or System appearance for stronger separation
          from the page.
        </li>
        <li>
          <strong>Add one quiet accent.</strong>
          Choose Caramel, Ube, Blueberry, Velvet, Custard, or Matcha across the outline,
          settings, and destination highlights.
        </li>
        <li>
          <strong>Keep only useful controls nearby.</strong>
          Dock left or right and independently show or hide the Top, Bottom, and
          Dock quick buttons.
        </li>
      </ul>
    </div>
    <figure class="feature-visual appearance-visual">
      <img
        src={withBase("/images/mockups/appearance-controls.jpg")}
        alt="Crumbs appearance settings showing Glazed and Plain styles, six accents, and quick-button controls"
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  <section class="privacy-section">
    <div class="shell privacy-grid">
      <div class="privacy-copy">
        <p class="eyebrow eyebrow-light">
          <span class="small-dot"></span>Privacy by design
        </p>
        <h2>Your reading stays on your device.</h2>
        <p>
          Crumbs processes headings, eligible Markdown, and preferences locally.
          It has no account system, analytics, advertising, telemetry, or
          developer-operated backend.
        </p>
        <a href={withBase("/privacy/")}
          >Read the full privacy policy <span aria-hidden="true">→</span></a
        >
      </div>
      <ul class="privacy-list" aria-label="Privacy highlights">
        <li>
          <span>01</span><div>
            <strong>No account required</strong><p>
              There is no Crumbs profile to create or maintain.
            </p>
          </div>
        </li>
        <li>
          <span>02</span><div>
            <strong>Preferences stay local</strong><p>
              Appearance, shortcuts, rules, and reader settings use Chrome's
              local extension storage.
            </p>
          </div>
        </li>
        <li>
          <span>03</span><div>
            <strong>No page-content backend</strong><p>
              Crumbs does not transmit handled page content or saved preferences
              to the developer.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section shell faq-section">
    <div class="section-intro compact">
      <p class="eyebrow"><span class="small-dot"></span>Good to know</p>
      <h2>Questions, answered.</h2>
    </div>
    <div class="faq-grid">
      <details open>
        <summary>What kinds of pages does Crumbs support?</summary>
        <p>
          Crumbs works on supported Chrome pages with visible, meaningful
          headings. Chrome blocks extensions on protected pages such as the
          Chrome Web Store and <code>chrome://</code> pages.
        </p>
      </details>
      <details>
        <summary>Can it read local Markdown files?</summary>
        <p>
          Yes. Enable Local Markdown files in Crumbs and grant Chrome's Allow
          access to file URLs permission, then refresh the file.
        </p>
      </details>
      <details>
        <summary>Does Crumbs save document contents?</summary>
        <p>
          No. It does not save the contents of web pages or Markdown documents.
          It can remember local preferences such as a document's Raw-view
          choice.
        </p>
      </details>
      <details>
        <summary>Where can I install it?</summary>
        <p>
          This site does not publish an install link yet because a verified
          store URL is not available. The link will be added once it can be
          verified.
        </p>
      </details>
    </div>
  </section>

  <section class="closing-cta shell">
    <div>
      <p class="eyebrow">
        <span class="small-dot"></span>Already using Crumbs?
      </p>
      <h2>Find an answer and get back to the page.</h2>
    </div>
    <a class="button button-primary" href={withBase("/help/")}
      >Open the help center</a
    >
  </section>
</SiteLayout>
