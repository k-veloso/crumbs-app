---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import markdownRaw from "../assets/images/mockups/markdown-raw.png";
import markdownReader from "../assets/images/mockups/markdown-reader.png";
import heroExpanded from "../assets/images/mockups/hero-expanded.png";
import heroCollapsed from "../assets/images/mockups/hero-collapsed.png";
import jsonRendered from "../assets/images/mockups/json-rendered.png";
import conversation from "../assets/images/mockups/chatgpt-conversation.png";
import searchHeadings from "../assets/images/mockups/search-headings.png";
import { withBase } from "../lib/paths";
---

<SiteLayout
  title="Crumbs"
  description="A Chrome extension for navigating long pages and reading standalone Markdown or JSON without losing your place."
  bodyClass="landing-page"
  outlineDemo
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-dot"></span>Navigate any page</p>
      <h1
        id="landing-top"
        data-crumbs-demo-heading
        data-crumbs-demo-level="1"
        data-crumbs-demo-label="Keep your place. Find what matters."
      >
        Keep your place.<br /><span>Find what matters.</span>
      </h1>
      <p class="hero-lede">
        Crumbs turns a page's headings into a focused outline and gives
        standalone Markdown and JSON a clean, browseable view—entirely local and
        private.
      </p>
      <div class="hero-actions">
        <a
          class="button button-primary"
          href={withBase("/help/getting-started/")}>See how Crumbs works</a
        >
        <a class="button button-secondary" href={withBase("/help/")}
          >Browse help <span aria-hidden="true">→</span></a
        >
        <button
          class="button button-secondary crumbs-demo-hero-activate"
          hidden
          type="button"
          aria-pressed="false"
          aria-controls="crumbs-demo-outline"
          data-crumbs-demo-activate>Try demo on this page</button
        >
      </div>
      <p class="availability-note">
        An install link will appear here when a verified store listing is
        available.
      </p>
    </div>

    <div class="hero-visual">
      <figure class="product-preview mockup-window mockup-window-hero">
        <div class="mockup-toolbar" aria-hidden="true">
          <span></span><span></span><span></span>
          <p>A long page, made navigable</p>
        </div>
        <div class="hero-screenshot-composite">
          <Image
            src={heroExpanded}
            alt="Crumbs expanded outline beside the Field Notes article"
            width={1600}
            layout="constrained"
            format="webp"
            quality={90}
            loading="eager"
            fetchpriority="high"
          />
          <svg
            class="hero-collapsed-inset"
            viewBox="2650 470 230 700"
            role="img"
            aria-label="Collapsed Crumbs heading rail and quick controls"
          >
            <image href={heroCollapsed.src} width="2880" height="1618" />
          </svg>
        </div>
        <figcaption>
          <span><i></i>Real extension states</span>
          <span>Collapsed · Expanded</span>
        </figcaption>
      </figure>
      <nav class="hero-highlights" aria-label="Crumbs features at a glance">
        <a href="#page-outline">Outline navigation</a>
        <a href="#page-outline">Search and depth</a>
        <a href="#markdown-reader">Markdown + JSON</a>
        <a href="#privacy">Private by design</a>
      </nav>
    </div>
  </section>

  <section class="section shell" id="features">
    <div class="section-intro">
      <p class="eyebrow">
        <span class="small-dot"></span>Made for your reading flow
      </p>
      <h2
        data-crumbs-demo-heading
        data-crumbs-demo-level="2"
        data-crumbs-demo-target="features"
        data-crumbs-demo-label="Less hunting. More understanding."
      >
        Less hunting.<br />More understanding.
      </h2>
      <p>
        Move through dense pages with a compact set of tools that stay out of
        the way until you need them.
      </p>
    </div>
    <nav class="feature-index" aria-label="Feature details">
      <a href="#page-outline">
        <span>01</span>
        <strong>Page outline</strong>
        <small>Collapse, preview, and jump between headings</small>
      </a>
      <a href="#chatgpt-outline">
        <span>02</span>
        <strong>ChatGPT conversation outline</strong>
        <small>Jump between questions, answers, and answer headings</small>
      </a>
      <a href="#markdown-reader">
        <span>03</span>
        <strong>Markdown reader</strong>
        <small>Render rich documents or return to raw source</small>
      </a>
      <a href="#json-reader">
        <span>04</span>
        <strong>JSON reader</strong>
        <small>Search, group, and copy deeply nested data</small>
      </a>
      <a href="#appearance">
        <span>05</span>
        <strong>Appearance</strong>
        <small>Choose Glazed or Plain in light or dark</small>
      </a>
    </nav>
  </section>

  <section class="feature-detail shell" id="page-outline">
    <div class="feature-detail-copy">
      <p class="feature-kicker"><span>01</span>Navigate long pages</p>
      <h2
        data-crumbs-demo-heading
        data-crumbs-demo-level="2"
        data-crumbs-demo-target="page-outline"
      >
        A living outline that knows when to get out of the way.
      </h2>
      <p class="feature-lede">
        Crumbs turns meaningful headings into a compact hierarchy, follows your
        current section, and folds back into a narrow rail whenever it is not
        hovered or pinned.
      </p>
      <ul class="feature-points">
        <li>
          <strong id="outline-move-with-document"
            >Move with the document.</strong
          >
          Click a heading to scroll smoothly to it and briefly highlight the destination
          on the page.
        </li>
        <li>
          <strong id="outline-hover-preview"
            >Preview without losing your flow.</strong
          >
          Hold <kbd>Shift</kbd> and hover over headings to move between sections
          quickly, without changing the URL or adding a page highlight.
        </li>
        <li>
          <strong id="outline-collapse-groups">Collapse nested groups.</strong>
          Fold finished branches away, then reveal them again when you need their
          detail.
        </li>
        <li>
          <strong id="outline-copy-section-link"
            >Copy a link to the exact section.</strong
          >
          Crumbs reuses a stable page anchor when one exists and can create a text-fragment
          link like Chrome's Copy link to highlight.
        </li>
        <li>
          <strong id="outline-search-and-depth"
            >Search, then choose a depth.</strong
          >
          Filter headings by text or show only levels through H1, H2, H3, and beyond.
          Hover a truncated heading to see its complete text in a tooltip.
        </li>
      </ul>
    </div>
    <figure class="feature-visual mockup-window">
      <div class="mockup-toolbar" aria-hidden="true">
        <span></span><span></span><span></span><p>Find a heading</p>
      </div>
      <Image
        src={searchHeadings}
        alt="Crumbs filtering a page outline to headings matching the word read"
        width={1383}
        layout="constrained"
        format="webp"
        quality={90}
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <span><i></i>Search in place</span><span>Only matching headings</span>
      </figcaption>
    </figure>
  </section>

  <section
    class="feature-detail feature-detail-reversed shell"
    id="chatgpt-outline"
  >
    <div class="feature-detail-copy">
      <p class="feature-kicker"><span>02</span>ChatGPT conversation outline</p>
      <h2
        data-crumbs-demo-heading
        data-crumbs-demo-level="2"
        data-crumbs-demo-target="chatgpt-outline"
      >
        Follow the conversation.
      </h2>
      <p class="feature-lede">
        Jump between your questions, answers, and headings inside long ChatGPT
        conversations—without losing your place.
      </p>
      <ul class="feature-points">
        <li>
          <strong>Find the exchange you need.</strong> Move directly to a question
          or answer instead of scrolling back through the conversation.
        </li>
        <li>
          <strong>Explore an answer’s structure.</strong> Expand its headings to
          reach the part you want to revisit.
        </li>
        <li>
          <strong>Keep time in view.</strong> Show optional question timestamps,
          with approximate times remembered locally when enabled.
        </li>
      </ul>
      <a class="feature-link" href={withBase("/help/")}
        >Browse Crumbs help <span aria-hidden="true">→</span></a
      >
    </div>
    <figure class="feature-visual mockup-window">
      <div class="mockup-toolbar" aria-hidden="true">
        <span></span><span></span><span></span><p>
          A long conversation, made navigable
        </p>
      </div>
      <Image
        src={conversation}
        alt="ChatGPT conversation with questions, answer headings, and a question timestamp in the Crumbs outline"
        width={1600}
        layout="constrained"
        format="webp"
        quality={90}
        loading="lazy"
      />
      <figcaption>
        <span><i></i>ChatGPT conversation outline</span><span
          >Questions · Answers · Headings</span
        >
      </figcaption>
    </figure>
  </section>

  <section class="feature-band" id="markdown-reader">
    <div class="feature-detail feature-detail-reader shell">
      <div class="feature-detail-copy">
        <p class="feature-kicker"><span>03</span>Read Markdown</p>
        <h2
          data-crumbs-demo-heading
          data-crumbs-demo-level="2"
          data-crumbs-demo-target="markdown-reader"
        >
          Readable when you want it. Raw when you need it.
        </h2>
        <p class="feature-lede">
          Open standalone Markdown from the web or from local files, then move
          between a calm rendered document and its original source.
        </p>
        <ul class="feature-points">
          <li>
            <strong id="markdown-real-documents"
              >Built for real documents.</strong
            >
            Read common Markdown plus GitHub-Flavored Markdown features such as tables,
            task lists, strikethrough, autolinks, and alerts.
          </li>
          <li>
            <strong id="markdown-diagrams">Diagrams stay useful.</strong>
            Mermaid diagrams include zoom, pan, reset, and source-copy controls.
          </li>
          <li>
            <strong id="markdown-code-blocks">Code remains practical.</strong>
            Syntax-highlighted code blocks include quick copy and per-block line
            wrapping.
          </li>
          <li>
            <strong id="markdown-local-files">Local files are supported.</strong
            >
            Enable local Markdown in Crumbs and grant Chrome file access once; the
            document itself remains on your device.
          </li>
        </ul>
        <a class="feature-link" href={withBase("/help/markdown-reader/")}
          >Explore Markdown support <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="reader-compare" aria-label="Rendered and Raw Markdown views">
        <figure class="reader-shot">
          <div class="shot-label">
            <span>Rendered</span><small>Readable view</small>
          </div>
          <Image
            src={markdownReader}
            alt="A public Markdown document rendered in dark mode with the Crumbs outline open"
            width={1380}
            layout="constrained"
            format="webp"
            quality={90}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="reader-shot reader-shot-raw">
          <div class="shot-label">
            <span>Raw</span><small>Original source</small>
          </div>
          <Image
            src={markdownRaw}
            alt="The same public Markdown document in Raw view with the Crumbs outline open"
            width={1378}
            layout="constrained"
            format="webp"
            quality={90}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section
    class="json-feature-band"
    id="json-reader"
    data-crumbs-demo-surface="dark"
    data-crumbs-demo-tint="#17191d"
  >
    <div
      class="feature-detail feature-detail-json feature-detail-reversed shell"
    >
      <div class="feature-detail-copy">
        <p class="feature-kicker"><span>04</span>Explore JSON</p>
        <h2
          data-crumbs-demo-heading
          data-crumbs-demo-level="2"
          data-crumbs-demo-target="json-reader"
        >
          See the structure before the noise.
        </h2>
        <p class="feature-lede">
          Turn standalone JSON responses into a collapsible tree, then search
          and copy the exact field you need without leaving the tab.
        </p>
        <ul class="feature-points">
          <li>
            <strong id="json-rendered-or-raw"
              >Rendered or source-faithful Raw.</strong
            >
            Explore nested objects and arrays, or return to the original decoded
            response text at any time.
          </li>
          <li>
            <strong id="json-search-response"
              >Search the entire response.</strong
            >
            Find keys, values, or JSON Pointer paths—even inside collapsed and not-yet-mounted
            branches.
          </li>
          <li>
            <strong id="json-repeated-records"
              >Understand repeated records.</strong
            >
            Grouped fields summarize occurrences, types, and small distinct-value
            counts across arrays.
          </li>
          <li>
            <strong id="json-copy-data">Copy without changing the data.</strong>
            Copy raw JSON, exact values, properties, JSON Pointers, or JSONPath-style
            locations without rounding large integers.
          </li>
          <li>
            <strong id="json-large-documents"
              >Stay responsive on large documents.</strong
            >
            Collections load progressively, with depth controls and clear safety
            limits when a response is too large to render.
          </li>
        </ul>
        <a class="feature-link" href={withBase("/help/json-reader/")}
          >Explore JSON support <span aria-hidden="true">→</span></a
        >
      </div>

      <figure
        class="json-product-preview"
        aria-label="Crumbs Rendered JSON reader with schema search results"
      >
        <Image
          src={jsonRendered}
          alt="Crumbs JSON reader displaying the package.json schema with nested definitions and outline search results"
          width={1600}
          layout="constrained"
          format="webp"
          quality={90}
          loading="lazy"
        />
        <figcaption>
          <span><i></i>Rendered response</span>
          <span>Search · Explore · Copy</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section
    class="feature-detail feature-detail-appearance shell"
    id="appearance"
  >
    <div class="feature-detail-copy">
      <p class="feature-kicker"><span>05</span>Make it yours</p>
      <h2
        data-crumbs-demo-heading
        data-crumbs-demo-level="2"
        data-crumbs-demo-target="appearance"
      >
        Blend into the page—or hold a clear edge.
      </h2>
      <p class="feature-lede">
        The interaction stays consistent while the surface adapts to the kind of
        page you are reading.
      </p>
      <ul class="feature-points">
        <li>
          <strong id="appearance-glazed">Glazed adapts.</strong>
          Its translucent, glass-like surface samples the page behind it and adjusts
          its tint and light or dark treatment automatically.
        </li>
        <li>
          <strong id="appearance-plain">Plain stays solid.</strong>
          Choose a solid Light, Dark, or System appearance for stronger separation
          from the page.
        </li>
        <li>
          <strong id="appearance-accent">Add one quiet accent.</strong>
          Choose Toast, Ube, Blueberry, Velvet, Custard, or Matcha across the outline,
          settings, and destination highlights.
        </li>
        <li>
          <strong id="appearance-quick-controls"
            >Keep only useful controls nearby.</strong
          >
          Dock left or right and independently show or hide the Top, Bottom, and
          Dock quick buttons.
        </li>
      </ul>
    </div>
    <figure class="feature-visual appearance-visual">
      <img
        src={withBase("/images/mockups/appearance-controls.png")}
        alt="Crumbs appearance settings showing Glazed and Plain styles, six accents, and outline visibility controls"
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  <section class="privacy-section" id="privacy">
    <div class="shell privacy-grid">
      <div class="privacy-copy">
        <p class="eyebrow eyebrow-light">
          <span class="small-dot"></span>Privacy by design
        </p>
        <h2
          data-crumbs-demo-heading
          data-crumbs-demo-level="2"
          data-crumbs-demo-target="privacy"
        >
          Your reading stays on your device.
        </h2>
        <p>
          Crumbs processes headings, eligible Markdown and JSON, and preferences
          locally. It has no account system, analytics, advertising, telemetry,
          or developer-operated backend.
        </p>
        <a href={withBase("/privacy/")}
          >Read the full privacy policy <span aria-hidden="true">→</span></a
        >
      </div>
      <ul class="privacy-list" aria-label="Privacy highlights">
        <li>
          <span>01</span><div>
            <strong>No account required</strong><p>
              There is no Crumbs profile to create or maintain.
            </p>
          </div>
        </li>
        <li>
          <span>02</span><div>
            <strong>Preferences stay local</strong><p>
              Appearance, shortcuts, rules, and reader settings use Chrome's
              local extension storage.
            </p>
          </div>
        </li>
        <li>
          <span>03</span><div>
            <strong>No page-content backend</strong><p>
              Crumbs does not transmit handled page content or saved preferences
              to the developer.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section shell faq-section">
    <div class="section-intro compact">
      <p class="eyebrow"><span class="small-dot"></span>Good to know</p>
      <h2 id="questions" data-crumbs-demo-heading data-crumbs-demo-level="2">
        Questions, answered.
      </h2>
    </div>
    <div class="faq-grid">
      <details open>
        <summary>What kinds of pages does Crumbs support?</summary>
        <p>
          Crumbs works on supported Chrome pages with visible, meaningful
          headings. Chrome blocks extensions on protected pages such as the
          Chrome Web Store and <code>chrome://</code> pages.
        </p>
      </details>
      <details>
        <summary>Can it read local Markdown and JSON files?</summary>
        <p>
          Yes. Both require Chrome's Allow access to file URLs permission. Local
          Markdown also requires the Local Markdown files setting; local JSON
          does not. Refresh the file after changing it.
        </p>
      </details>
      <details>
        <summary>Does Crumbs save document contents?</summary>
        <p>
          No. It does not save the contents of web pages, Markdown documents, or
          JSON responses. It can remember local preferences such as a document's
          Raw-view choice.
        </p>
      </details>
      <details>
        <summary>Where can I install it?</summary>
        <p>
          This site does not publish an install link yet because a verified
          store URL is not available. The link will be added once it can be
          verified.
        </p>
      </details>
    </div>
  </section>

  <section class="closing-cta shell">
    <div>
      <p class="eyebrow">
        <span class="small-dot"></span>Already using Crumbs?
      </p>
      <h2
        id="find-an-answer"
        data-crumbs-demo-heading
        data-crumbs-demo-level="2"
      >
        Find an answer and get back to the page.
      </h2>
    </div>
    <a class="button button-primary" href={withBase("/help/")}
      >Open the help center</a
    >
  </section>
</SiteLayout>
