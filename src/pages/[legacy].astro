---
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../lib/paths";

export function getStaticPaths() {
  return [
    {
      params: { legacy: "getting-started" },
      props: {
        label: "Getting Started",
        destination: "/help/getting-started/",
      },
    },
    {
      params: { legacy: "markdown-reader" },
      props: {
        label: "Reading Markdown",
        destination: "/help/markdown-reader/",
      },
    },
    {
      params: { legacy: "shortcuts" },
      props: { label: "Keyboard Shortcuts", destination: "/help/shortcuts/" },
    },
    {
      params: { legacy: "troubleshooting" },
      props: {
        label: "Troubleshooting",
        destination: "/help/troubleshooting/",
      },
    },
  ];
}

const { label, destination } = Astro.props;
const target = withBase(destination);
---

<SiteLayout
  title={`${label} moved`}
  description={`The ${label} guide has moved into the Crumbs help center.`}
  bodyClass="article-page"
>
  <meta http-equiv="refresh" content={`0;url=${target}`} slot="head" />
  <div class="redirect-card shell">
    <p class="eyebrow"><span class="small-dot"></span>Guide moved</p>
    <h1>{label} has a new address.</h1>
    <p>
      You should be redirected automatically. If not, <a href={target}
        >open the guide</a
      >.
    </p>
  </div>
  <script is:inline define:vars={{ target }}>
    window.location.replace(
      target + window.location.search + window.location.hash,
    );
  </script>
</SiteLayout>
